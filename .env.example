# MeshCore USB companion
MESHCORE_SERIAL=/dev/ttyACM0
MESHCORE_BAUD=115200
MESHCORE_DEBUG=false

ENABLE_DIRECT_MESSAGES=true
ENABLE_CHANNEL_MESSAGES=true
ALLOWED_CHANNELS=
ALLOWED_CONTACT_PREFIXES=
AI_PREFIX=AI:

# Reliability for DIRECT messages
WAIT_FOR_DIRECT_ACK=true
ACK_TIMEOUT_SECONDS=12
DIRECT_SEND_RETRIES=2

# Existing Open WebUI on the Raspberry Pi
OPENWEBUI_URL=http://host.docker.internal:3000
OPENWEBUI_API_KEY=REPLACE_ME

# Exact model IDs as shown by Open WebUI
FAST_MODEL=Qwen3-0.6B-GGUF
ASK_MODEL=Qwen3.5-4B-MTP-GGUF
DEEP_MODEL=qwen38-27b

# Normal replies
MAX_OUTPUT_TOKENS=180
MAX_REPLY_CHARS=700

# /short replies
SHORT_OUTPUT_TOKENS=80
SHORT_REPLY_CHARS=220

TEMPERATURE=0.2
REQUEST_TIMEOUT_SECONDS=120

# MeshCore chunking
MESH_CHUNK_CHARS=120
CHUNK_DELAY_SECONDS=1.0
MAX_CONCURRENT_REQUESTS=1
DEDUPE_TTL_SECONDS=300

# Reasoning control for radio use
DISABLE_THINKING_FAST=true
DISABLE_THINKING_ASK=true
DISABLE_THINKING_DEEP=false

# Retry once if Open WebUI returns no visible assistant content
EMPTY_RESPONSE_RETRY=true
EMPTY_RESPONSE_RETRY_TOKENS=512
